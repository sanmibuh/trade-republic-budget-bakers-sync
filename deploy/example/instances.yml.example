# instances.yml — config for the single tr-sync container
# Copy to instances.yml and fill in real values (never commit the real file).
#
# The container reads this file via the INSTANCES_CONFIG env var.
# Each instance gets its own data subdirectory: {data_dir}/{name}/

# Root data directory inside the container (must match the volume mount in docker-compose.yml)
data_dir: /app/data

# Telegram credentials (shared by all instances)
telegram_bot_token: "<bot_token>"
telegram_chat_id: "<chat_id>"

# Set to true only if SSL verification fails in your environment
allow_insecure_ssl: false

# Backup schedule (cron expression). Remove or leave blank to disable automatic backups.
backup_schedule: "0 3 * * *"

sync:
  # Sync schedule applied to all instances (overridable per instance below).
  schedule: "0 8,14,21 * * *"

  # Global defaults — inherited by every instance; override per-instance as needed.
  wallet_api_key: "<shared_wallet_api_key>"
  lookback_days: 7
  category_strategy: "history"   # none | history

  instances:
    - name: user1                                  # used as the data subdirectory name
      phone: "+49123456789"                        # Trade Republic phone number
      pin: "1234"                                  # Trade Republic PIN
      wallet_cash_account_id: "<uuid>"             # BudgetBakers cash account UUID
      wallet_portfolio_account_id: "<uuid>"        # BudgetBakers portfolio account UUID
      owner_name: "User 1"                         # optional, shown in Telegram messages

    - name: user2
      phone: "+49987654321"
      pin: "5678"
      wallet_cash_account_id: "<uuid>"
      wallet_portfolio_account_id: "<uuid>"
      owner_name: "User 2"
      # Per-instance overrides (all optional):
      # wallet_api_key: "<user2_own_key>"
      # lookback_days: 14
      # category_strategy: "none"
      # schedule: "5 8,14,21 * * *"              # stagger to avoid parallel TR logins
